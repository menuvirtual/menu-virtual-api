# Copie para .env e ajuste. Os valores abaixo são os padrões (batem com o docker-compose.yml).
PORT=3000
CORS_ORIGIN=*
DATA_DIR=./data

DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=menu
DB_PASSWORD=menu
DB_NAME=menu
# Aplica as migrations pendentes ao subir a API
DB_MIGRATIONS_RUN=true
# Loga o SQL executado
DB_LOGGING=false

# AWS Cognito. Em desenvolvimento: cognito-local do docker-compose;
# `npm run cognito:setup` cria o pool/client/usuários e grava os ids no .env.
# Em produção: deixe COGNITO_ENDPOINT vazio e informe o pool e o client reais.
COGNITO_ENDPOINT=http://localhost:9229
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Segredo do app client, se ele tiver (recomendado em produção)
COGNITO_CLIENT_SECRET=
COGNITO_GRUPO_SUPERUSUARIO=SuperUsuario

# Captcha (ALTCHA) temporariamente desativado; configuração preservada para retomada.
# CAPTCHA_SECRET=
# CAPTCHA_VALIDADE=600
